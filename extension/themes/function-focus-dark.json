    "editorIndentGuide.background1": "#363D47",
    "editorIndentGuide.activeBackground1": "#6483A4",
    "editorBracketMatch.background": "#344C6570",
    "editorBracketMatch.border": "#6483A4",
    "editorBracketHighlight.unexpectedBracket.foreground": "#FF919E",
    "editorWhitespace.foreground": "#363D47",
    "editorRuler.foreground": "#363D47",
    "editorGutter.background": "#1B1E22",
    "editorGutter.addedBackground": "#8BCDAB",
    "editorGutter.modifiedBackground": "#6AC4FF",
    "editorGutter.deletedBackground": "#FF919E",
    "editorError.foreground": "#FF919E",
    "editorWarning.foreground": "#E8C376",
    "editorInfo.foreground": "#6AC4FF",
    "editorHint.foreground": "#A1A9B3",
    "editorOverviewRuler.border": "#00000000",
    "editorWidget.background": "#282D33",
    "editorWidget.foreground": "#D2D7DF",
    "editorWidget.border": "#3C434D",
    "editorHoverWidget.background": "#282D33",
    "editorHoverWidget.foreground": "#D2D7DF",
    "editorHoverWidget.border": "#3C434D",
    "editorSuggestWidget.background": "#282D33",
    "editorSuggestWidget.foreground": "#D2D7DF",
    "editorSuggestWidget.selectedBackground": "#344C65",
    "editorSuggestWidget.highlightForeground": "#6AC4FF",
    "editorSuggestWidget.border": "#3C434D",
    "editorInlayHint.foreground": "#A1A9B3",
    "editorInlayHint.background": "#22262B",
    "editorCodeLens.foreground": "#A1A9B3",
    "editorStickyScroll.background": "#1B1E22",
    "editorStickyScroll.border": "#3C434D",
    "editorGroup.border": "#3C434D",
    "editorGroupHeader.tabsBackground": "#22262B",
    "editorGroupHeader.tabsBorder": "#3C434D",
    "tab.activeBackground": "#1B1E22",
    "tab.activeForeground": "#D2D7DF",
    "tab.activeBorderTop": "#6AC4FF",
    "tab.inactiveBackground": "#22262B",
    "tab.inactiveForeground": "#A1A9B3",
    "tab.border": "#3C434D",
    "sideBar.background": "#22262B",
    "sideBar.foreground": "#D2D7DF",
    "sideBar.border": "#3C434D",
    "sideBarSectionHeader.background": "#22262B",
    "sideBarSectionHeader.foreground": "#A1A9B3",
    "sideBarSectionHeader.border": "#3C434D",
    "activityBar.background": "#22262B",
    "activityBar.foreground": "#6AC4FF",
    "activityBar.inactiveForeground": "#A1A9B3",
    "activityBar.border": "#3C434D",
    "activityBarBadge.background": "#6AC4FF",
    "activityBarBadge.foreground": "#1B1E22",
    "titleBar.activeBackground": "#22262B",
    "titleBar.activeForeground": "#D2D7DF",
    "titleBar.inactiveBackground": "#22262B",
    "titleBar.inactiveForeground": "#A1A9B3",
    "titleBar.border": "#3C434D",
    "statusBar.background": "#22262B",
    "statusBar.foreground": "#A1A9B3",
    "statusBar.border": "#3C434D",
    "statusBar.noFolderBackground": "#22262B",
    "statusBar.debuggingBackground": "#22262B",
    "statusBar.debuggingForeground": "#E8C376",
    "statusBarItem.remoteBackground": "#22262B",
    "statusBarItem.remoteForeground": "#7ABFC0",
    "panel.background": "#1B1E22",
    "panel.border": "#3C434D",
    "panelTitle.activeForeground": "#D2D7DF",
    "panelTitle.inactiveForeground": "#A1A9B3",
    "panelTitle.activeBorder": "#6AC4FF",
    "input.background": "#282D33",
    "input.foreground": "#D2D7DF",
    "input.border": "#3C434D",
    "input.placeholderForeground": "#A1A9B3",
    "inputOption.activeBackground": "#344C65",
    "inputOption.activeBorder": "#6AC4FF",
    "dropdown.background": "#282D33",
    "dropdown.foreground": "#D2D7DF",
    "dropdown.border": "#3C434D",
    "button.background": "#6AC4FF",
    "button.foreground": "#1B1E22",
    "button.hoverBackground": "#7ABFC0",
    "button.secondaryBackground": "#303A46",
    "button.secondaryForeground": "#D2D7DF",
    "badge.background": "#303A46",
    "badge.foreground": "#D2D7DF",
    "list.activeSelectionBackground": "#344C65",
    "list.activeSelectionForeground": "#D2D7DF",
    "list.inactiveSelectionBackground": "#303A46",
    "list.inactiveSelectionForeground": "#D2D7DF",
    "list.hoverBackground": "#23282F",
    "list.focusBackground": "#344C65",
    "list.focusForeground": "#D2D7DF",
    "list.highlightForeground": "#6AC4FF",
    "list.errorForeground": "#FF919E",
    "list.warningForeground": "#E8C376",
    "quickInput.background": "#282D33",
    "quickInput.foreground": "#D2D7DF",
    "quickInputList.focusBackground": "#344C65",
    "notifications.background": "#282D33",
    "notifications.foreground": "#D2D7DF",
    "notifications.border": "#3C434D",
    "scrollbarSlider.background": "#A1A9B330",
    "scrollbarSlider.hoverBackground": "#A1A9B355",
    "scrollbarSlider.activeBackground": "#A1A9B370",
    "breadcrumb.foreground": "#A1A9B3",
    "breadcrumb.focusForeground": "#6AC4FF",
    "breadcrumb.activeSelectionForeground": "#D2D7DF",
    "minimap.selectionHighlight": "#6483A4",
    "gitDecoration.modifiedResourceForeground": "#7ABFC0",
    "gitDecoration.untrackedResourceForeground": "#8BCDAB",
    "gitDecoration.deletedResourceForeground": "#FF919E",
    "gitDecoration.ignoredResourceForeground": "#A1A9B3",
    "diffEditor.insertedTextBackground": "#8BCDAB20",
    "diffEditor.removedTextBackground": "#FF919E20",
    "terminal.background": "#1B1E22",
    "terminal.foreground": "#D2D7DF",
    "terminalCursor.foreground": "#6AC4FF",
    "terminal.selectionBackground": "#344C65",
    "symbolIcon.functionForeground": "#6AC4FF",
    "symbolIcon.methodForeground": "#6AC4FF",
    "symbolIcon.classForeground": "#C3A6E8",
    "symbolIcon.variableForeground": "#D2D7DF",
    "symbolIcon.parameterForeground": "#FFD166",
    "editorBracketHighlight.foreground1": "#9AB9D6",
    "editorBracketHighlight.foreground2": "#C8B784",
    "editorBracketHighlight.foreground3": "#BDA5D5",
    "editorBracketHighlight.foreground4": "#9AB9D6",
    "editorBracketHighlight.foreground5": "#C8B784",
    "editorBracketHighlight.foreground6": "#BDA5D5",
    "terminal.ansiBlack": "#555E69",
    "terminal.ansiBrightBlack": "#555E69",
    "terminal.ansiRed": "#FF919E",
    "terminal.ansiBrightRed": "#FF919E",
    "terminal.ansiGreen": "#8BCDAB",
    "terminal.ansiBrightGreen": "#8BCDAB",
    "terminal.ansiYellow": "#E8C376",
    "terminal.ansiBrightYellow": "#E8C376",
    "terminal.ansiBlue": "#6AC4FF",
    "terminal.ansiBrightBlue": "#6AC4FF",
    "terminal.ansiMagenta": "#C3A6E8",
    "terminal.ansiBrightMagenta": "#C3A6E8",
    "terminal.ansiCyan": "#7ABFC0",
    "terminal.ansiBrightCyan": "#7ABFC0",
    "terminal.ansiWhite": "#D2D7DF",
    "terminal.ansiBrightWhite": "#D2D7DF"
  },
  "tokenColors": [
    {
      "name": "Ordinary names",
      "scope": [
        "variable",
        "support.variable",
        "entity.name.variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D2D7DF",
        "fontStyle": ""
      }
    },
    {
      "name": "Quiet strings and docstrings",
      "scope": [
        "string",
        "string.quoted.docstring",
        "string.unquoted",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A3B19F",
        "fontStyle": ""
      }
    },
    {
      "name": "Readable quiet comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#969CA4",
        "fontStyle": ""
      }
    },
    {
      "name": "Literal punctuation",
      "scope": [
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#A3B19F",
        "fontStyle": ""
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#7ABFC0",
        "fontStyle": ""
      }
    },
    {
      "name": "Code inside interpolation",
      "scope": [
        "meta.embedded",
        "meta.fstring.python"
      ],
      "settings": {
        "foreground": "#D2D7DF",
        "fontStyle": ""
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#B7ABC9",
        "fontStyle": ""
      }
    },
    {
      "name": "Control flow and returns",
      "scope": [
        "keyword.control",
        "keyword.control.flow",
        "keyword.control.conditional",
        "keyword.control.loop",
        "keyword.control.exception",
        "keyword.control.import",
        "keyword.other.using"
      ],
      "settings": {
        "foreground": "#FFA0A8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Definition boundaries",
      "scope": [
        "storage.type.function",
        "storage.type.class",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#FFA0A8",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#B8C4D4",
        "fontStyle": ""
      }
    },
    {
      "name": "Word operators",
      "scope": [
        "keyword.operator.logical.python",
        "keyword.operator.wordlike",
        "keyword.operator.expression.await"
      ],
      "settings": {
        "foreground": "#FFA0A8",
        "fontStyle": ""
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.arguments",
        "punctuation.definition.parameters",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#9BA7B6",
        "fontStyle": ""
      }
    },
    {
      "name": "Function and method declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#6AC4FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Function and method calls",
      "scope": [
        "meta.function-call entity.name.function",
        "meta.function-call.generic.python",
        "meta.function-call.python",
        "meta.method-call entity.name.function",
        "support.function"
      ],
      "settings": {
        "foreground": "#6AC4FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Call argument names",
      "scope": [
        "meta.function-call.arguments",
        "meta.function-call.arguments.python"
      ],
      "settings": {
        "foreground": "#D2D7DF",
        "fontStyle": ""
      }
    },
    {
      "name": "Built-in helpers",
      "scope": [
        "support.function.builtin",
        "support.function.builtins"
      ],
      "settings": {
        "foreground": "#7ABFC0",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "entity.name.variable.parameter"
      ],
      "settings": {
        "foreground": "#FFD166",
        "fontStyle": ""
      }
    },
    {
      "name": "Receiver self and cls",
      "scope": [
        "variable.language",
        "variable.parameter.function.language.special.self.python",
        "variable.parameter.function.language.special.cls.python",
        "variable.language.special.self.python",
        "variable.language.special.cls.python"
      ],
      "settings": {
        "foreground": "#A1A9B3",
        "fontStyle": ""
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class"
      ],
      "settings": {
        "foreground": "#C3A6E8",
        "fontStyle": ""
      }
    },
    {
      "name": "Modules and namespaces",
      "scope": [
        "entity.name.namespace",
        "support.module",
        "support.other.module"
      ],
      "settings": {
        "foreground": "#D2D7DF",
        "fontStyle": ""
      }
    },
    {
      "name": "Decorators",
      "scope": [
        "entity.name.function.decorator",
        "meta.function.decorator",
        "punctuation.definition.decorator"
      ],
      "settings": {
        "foreground": "#C3A6E8",
        "fontStyle": ""
      }
    },
    {
      "name": "Numbers and boolean values",
      "scope": [
        "constant.numeric",
        "constant.language",
        "variable.other.constant",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#DEBC7D",
        "fontStyle": ""
      }
    },
    {
      "name": "Configuration keys",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.jsonc",
        "entity.name.tag.yaml",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#D2D7DF",
        "fontStyle": ""
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#6AC4FF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D2D7DF",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown italics",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D2D7DF",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7ABFC0",
        "fontStyle": ""
      }
    },
    {
      "name": "Added text",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#8BCDAB",
        "fontStyle": ""
      }
    },
    {
      "name": "Removed text",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#FF919E",
        "fontStyle": ""
      }
    },
    {
      "name": "Invalid syntax",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FF919E",
        "fontStyle": ""
      }
    }
  ],
  "semanticTokenColors": {
    "variable": {
      "foreground": "#D2D7DF",
      "bold": false,
      "italic": false
    },
    "property": {
      "foreground": "#D2D7DF",
      "bold": false,
      "italic": false
    },
    "parameter": {
      "foreground": "#FFD166",
      "bold": false,
      "italic": false
    },
    "selfParameter": {
      "foreground": "#A1A9B3",
      "bold": false,
      "italic": false
    },
    "clsParameter": {
      "foreground": "#A1A9B3",
      "bold": false,
      "italic": false
    },
    "function": {
      "foreground": "#6AC4FF",
      "bold": true,
      "italic": false
    },
    "method": {
      "foreground": "#6AC4FF",
      "bold": true,
      "italic": false
    },
    "function.declaration": {
      "foreground": "#6AC4FF",
      "bold": true,
      "italic": false
    },
    "function.definition": {
      "foreground": "#6AC4FF",
      "bold": true,
      "italic": false
    },
    "method.declaration": {
      "foreground": "#6AC4FF",
      "bold": true,
      "italic": false
    },
    "method.definition": {
      "foreground": "#6AC4FF",
      "bold": true,
      "italic": false
    },
    "function.defaultLibrary": {
      "foreground": "#7ABFC0",
      "bold": true,
      "italic": false
    },
    "method.defaultLibrary": {
      "foreground": "#7ABFC0",
      "bold": true,
      "italic": false
    },
    "class": {
      "foreground": "#C3A6E8",
      "bold": false,
      "italic": false
    },
    "class.declaration": {
      "foreground": "#C3A6E8",
      "bold": true,
      "italic": false
    },
    "type": {
      "foreground": "#C3A6E8",
      "bold": false,
      "italic": false
    },
    "typeParameter": {
      "foreground": "#C3A6E8",
      "bold": false,
      "italic": false
    },
    "interface": {
      "foreground": "#C3A6E8",
      "bold": false,
      "italic": false
    },
    "namespace": {
      "foreground": "#D2D7DF",
      "bold": false,
      "italic": false
    },
    "module": {
      "foreground": "#D2D7DF",
      "bold": false,
      "italic": false
    },
    "decorator": {
      "foreground": "#C3A6E8",
      "bold": false,
      "italic": false
    },
    "keyword": {
      "foreground": "#FFA0A8",
      "bold": true,
      "italic": false
    },
    "operator": {
      "foreground": "#B8C4D4",
      "bold": false,
      "italic": false
    },
    "string": {
      "foreground": "#A3B19F",
      "bold": false,
      "italic": false
    },
    "comment": {
      "foreground": "#969CA4",
      "bold": false,
      "italic": false
    },
    "number": {
      "foreground": "#DEBC7D",
      "bold": false,
      "italic": false
    },
    "enumMember": {
      "foreground": "#DEBC7D",
      "bold": false,
      "italic": false
    },
    "variable.readonly": {
      "foreground": "#DEBC7D",
      "bold": false,
      "italic": false
    }
  }
}
